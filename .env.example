FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-change-in-production
DATABASE_URL=sqlite:///scraper.db

# --- Video -> Animation feature ---
# Where uploaded videos and rendered animations are stored.
MEDIA_ROOT=media
# Max upload size in megabytes.
MAX_UPLOAD_MB=200
# Only needed for the "ai" engine (Replicate). Leave empty to use the free
# local cartoon filter.
REPLICATE_API_TOKEN=
# Optional: override the Replicate model ("owner/model" or "owner/model:version").
REPLICATE_MODEL=
